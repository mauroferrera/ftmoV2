# ===================================
# FTMO Dashboard - .env.example
# ===================================
# Copiar a .env y rellenar. El .env NO se versiona (.gitignore).

# Entorno de ejecución
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Servidor FastAPI
# Para acceso desde el celular en la misma WiFi: HOST=0.0.0.0
# (solo desarrollo local: HOST=127.0.0.1).
HOST=127.0.0.1
PORT=8000

# Orígenes CORS permitidos (separados por comas). NUNCA "*".
# Para LAN añade la IP del PC: http://192.168.1.50:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Token de la API. Vacío = sin autenticación (desarrollo local).
# En LAN es OBLIGATORIO: sin él cualquiera en la red podría operar la cuenta.
API_TOKEN=

# ===================================
# MetaTrader 5 / Cuenta FTMO
# ===================================
# Número de cuenta / usuario de FTMO (MT5 Login)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Ruta al terminal64.exe si no está en la ubicación por defecto.
MT5_PATH=
# Perfil FTMO (por defecto: ftmo_2step_25k | ftmo_1step_25k)
FTMO_PROFILE=ftmo_2step_25k

# --- Varias cuentas (4 previstas) ---
# UNA sola terminal MT5: el paquete solo mantiene una conexión por proceso, así
# que la cuenta se cambia con mt5.login() sobre esa conexión (D-031). No hace
# falta un terminal por cuenta; MT5_PATH_<LOGIN> solo si una cuenta vive en otra
# instalación. Las variables genéricas de arriba son el fallback; para
# credenciales DISTINTAS por cuenta usa el sufijo del login:
#   MT5_PASSWORD_112125897=...
#   MT5_SERVER_112125897=FTMO-Server
#   MT5_PATH_112125897=C:\...\terminal64.exe   (solo si esa cuenta usa otro terminal)
# Lista de logins que aparecen en el selector de cuenta activa del dashboard
# (separados por comas). No se versionan números de cuenta en el repo.
# MT5_ACCOUNTS=112125897,223344556,334455667,445566778
# Perfil FTMO de cada login (si falta, se usa FTMO_PROFILE y luego ftmo_2step_25k):
#   FTMO_PROFILE_112125897=ftmo_2step_25k
#   FTMO_PROFILE_223344556=ftmo_1step_25k

# ===================================
# Agente IA (Google Gemini / Tribunal EUR/USD)
# ===================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LITELLM_MODEL=gemini-3.8-flash

# ===================================
# Rutas (opcionales; hay defaults en core/paths.py)
# ===================================
# Raíz de datos PESADOS (capturas), fuera del repo y de OneDrive.
# FTMO_DATA_ROOT=C:\Users\me\Desktop\ftmo_data
# Override del fichero de estrategia.
# STRATEGY_PATH=

TZ=UTC
